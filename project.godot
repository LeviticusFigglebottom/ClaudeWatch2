; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this file is written by hand and kept tidy.

config_version=5

[application]

config/name="Ringfall"
config/description="Team-based hero shooter. Ten Runners, two Charters, one Core."
config/version="0.1.0"
run/main_scene="res://src/app/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=240
boot_splash/bg_color=Color(0.05, 0.06, 0.09, 1)
boot_splash/show_image=false
config/icon="res://assets/ui/icon.png"

[autoload]

EventBus="*res://src/core/EventBus.gd"
Registry="*res://src/core/Registry.gd"
Settings="*res://src/core/Settings.gd"
Console="*res://src/core/Console.gd"
App="*res://src/app/App.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/shadowed_variable=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[editor]

version_control/plugin_name="GitPlugin"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

