[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="pawn"
3d_physics/layer_3="barrier_team_a"
3d_physics/layer_4="barrier_team_b"
3d_physics/layer_5="deployable"
3d_physics/layer_6="trigger"
3d_physics/layer_7="pickup"
3d_physics/layer_8="payload"
3d_physics/layer_9="projectile_blocker"
3d_physics/layer_10="nav_only"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=64
common/physics_interpolation=true
3d/default_gravity=9.8
3d/physics_engine="GodotPhysics3D"

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.09, 1)
occlusion_culling/use_occlusion_culling=true
scaling_3d/mode=0

[importer_defaults]

texture={
"compress/mode": 2,
"compress/high_quality": true,
"compress/hdr_compression": 1,
"mipmaps/generate": true,
"detect_3d/compress_to": 0,
"roughness/mode": 0
}
