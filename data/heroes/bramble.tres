[resource]
script = ExtResource("15_ikye6")
id = &"bramble"
display_name = "Bramble"
codename = "The Terraformer"
sort_order = 17
tagline = "Stand still. It's easier."
lore = "Bramble spent a decade seeding the Cascadian seed-vault campus with engineered thorn that could hold a hillside together after the fires. When the Charter that hired her tried to burn it back, the hillside held and the Charter did not. She carries the thorn in a bow now, and still talks about drainage."
playstyle = "Poke at mid range and stack three thorns on one target to root it, then land the Snare or a Thicket to keep it there for your team. Overgrowth roots a whole fight and heals your side of it. You lose to cleanse and to anyone who out-ranges 30 m."
movement = SubResource("Resource_ikye6")
hitbox = SubResource("Resource_8wro5")
primary = SubResource("Resource_72d62")
secondary = SubResource("Resource_c4oqh")
ability_1 = SubResource("Resource_6eb46")
ability_2 = SubResource("Resource_w6nfu")
ultimate = SubResource("Resource_qsppm")
hero_script = ExtResource("12_am7ll")
visual = SubResource("Resource_ulntq")
audio = SubResource("Resource_vlt8v")
theme_color = Color(0.46, 0.74, 0.28, 1)
ai = SubResource("Resource_am7ll")
counters = Array[StringName]([&"harrier", &"sable", &"wisp", &"ballast"])
countered_by = Array[StringName]([&"tallow", &"suture", &"cathedral", &"vesper"])
synergies = Array[StringName]([&"coil", &"rook", &"bombard"])
unique_mechanic = "Roots: the third consecutive thorn hit on the same target (within 2 s of the last) roots it for 1.2 s. Switching targets or pausing resets the count."
difficulty = 2
