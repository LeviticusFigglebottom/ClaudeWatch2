[resource]
script = ExtResource("16_3idsv")
id = &"bombard"
display_name = "Bombard"
codename = "The Spotter"
sort_order = 15
tagline = "You don't need to see it. I do."
lore = "Bombard called fire for the Andean Charter's border militia until a ceasefire made her obsolete. She kept the mortar, rebuilt the spotter drone from a weather satellite that fell in her yard, and hires out to whoever holds the high ground. She talks to her shells while they're in the air."
playstyle = "Sit behind cover on high ground and drop shells where the reticle says they land: you never need a sightline. Tag the fight with the Spotter drone, airburst anyone hiding behind a wall, and save Barrage for a held point. You are helpless when dived: Kick Charge is your only way out."
health = 225.0
movement = SubResource("Resource_i4r4b")
hitbox = SubResource("Resource_rmocy")
primary = SubResource("Resource_0t1ig")
secondary = SubResource("Resource_0l8vv")
ability_1 = SubResource("Resource_hy560")
ability_2 = SubResource("Resource_4ad0q")
ultimate = SubResource("Resource_8wsfc")
hero_script = ExtResource("12_wrnj2")
visual = SubResource("Resource_njlap")
audio = SubResource("Resource_wrnj2")
theme_color = Color(0.86, 0.64, 0.24, 1)
ai = SubResource("Resource_012s8")
counters = Array[StringName]([&"cathedral", &"rook", &"cairn", &"kiln"])
countered_by = Array[StringName]([&"harrier", &"sable", &"wisp"])
synergies = Array[StringName]([&"vesper", &"rook", &"cairn"])
unique_mechanic = "Indirect fire: the mortar's predicted landing point is drawn as a world-space reticle visible through walls, so every shell can be lobbed over cover blind."
difficulty = 3
