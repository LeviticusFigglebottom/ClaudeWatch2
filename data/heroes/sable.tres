[resource]
script = ExtResource("13_j5753")
id = &"sable"
display_name = "Sable"
codename = "The Shadow-dancer"
sort_order = 16
tagline = "You'll hear the second cut."
lore = "Sable danced in the Pearl River Charter's lantern theatres until the theatres were bought by a Charter that preferred quiet. She kept the blades from the last show, learned that stillness is the only real camouflage, and now takes contracts against the loud. She never runs in; she arrives."
playstyle = "Creep in Shroud below 40% speed, open from behind for 2.5x, finish the three-hit combo and Vault out before the team turns. Lunge closes the last gap. Requiem is a team wipe if they are clumped and nobody has reveal or a save."
health = 225.0
movement = SubResource("Resource_qjs8n")
hitbox = SubResource("Resource_wqqoj")
primary = SubResource("Resource_0y2p7")
secondary = SubResource("Resource_gbq8l")
ability_1 = SubResource("Resource_jui31")
ability_2 = SubResource("Resource_eyelq")
ultimate = SubResource("Resource_g11si")
hero_script = ExtResource("9_ho1ra")
visual = SubResource("Resource_d0eay")
audio = SubResource("Resource_cny6m")
theme_color = Color(0.58, 0.32, 0.8, 1)
ai = SubResource("Resource_ho1ra")
counters = Array[StringName]([&"tallow", &"suture", &"vesper", &"lumen"])
countered_by = Array[StringName]([&"vesper", &"bombard", &"coil", &"rook"])
synergies = Array[StringName]([&"tallow", &"wisp", &"ballast"])
unique_mechanic = "Backstab: every blade hit from behind deals 2.5x. Shroud keeps you invisible only while moving below 40% speed; sprinting or striking breaks it for 1 s."
difficulty = 3
