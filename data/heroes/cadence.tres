[resource]
script = ExtResource("16_ptvtf")
id = &"cadence"
display_name = "Cadence"
codename = "The Bassline"
role = 2
sort_order = 21
tagline = "Keep time. Keep breathing."
lore = "Cadence busked the transit tunnels of the Pearl River Charter with a sub-woofer bolted to a scavenged pressure cannon, and discovered that a crowd that moves together bleeds less. The Charters call it acoustic field therapy. She calls it a set. Her runner contract has one clause: the cannon stays tuned to 120."
playstyle = "Stand in the middle of your team with the Groove on and let the beat do the healing. Learn the metronome: Bassline shells fired on the beat hit harder, heal around the impact and double the next pulse. Crescendo to reposition the whole team, Discord to open a target, Anthem before the enemy commits."
health = 220.0
movement = SubResource("Resource_668pd")
hitbox = SubResource("Resource_lprni")
primary = SubResource("Resource_c46d2")
secondary = SubResource("Resource_xbr0o")
ability_1 = SubResource("Resource_nkqc0")
ability_2 = SubResource("Resource_g724a")
ultimate = SubResource("Resource_ug0yt")
hero_script = ExtResource("11_g724a")
visual = SubResource("Resource_x2uny")
audio = SubResource("Resource_db33b")
theme_color = Color(0.95, 0.38, 0.72, 1)
ai = SubResource("Resource_1k3ed")
counters = Array[StringName]([&"bombard", &"bramble", &"rook"])
countered_by = Array[StringName]([&"coil", &"wisp", &"sable"])
synergies = Array[StringName]([&"harrier", &"ballast", &"sable"])
unique_mechanic = "On the beat: a 120 bpm clock. Groove heals allies within 9 m for 12 on every beat; Bassline shots fired within 66 ms of a beat deal 1.5x, heal allies within 4 m of the impact for 30, and make the next Groove pulse heal 24."
difficulty = 2
