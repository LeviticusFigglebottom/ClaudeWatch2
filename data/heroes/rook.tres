[resource]
script = ExtResource("14_hrtfr")
id = &"rook"
display_name = "Rook"
codename = "The Engineer"
role = 0
sort_order = 5
tagline = "Down is a suggestion."
lore = "Rook kept Meridian Station's gravity plating alive for six years after the rest of the segment went dark, alone with the hum and a workshop full of field coils. When the Charters finally sent a salvage team she met them at the airlock in a hover-frame she had built from the station's own bones, and asked, politely, what they were offering. She has never fully trusted the ground since. She does not need to."
playstyle = "Hold a zone and make it expensive to enter. Mortar shells arc over cover and punish groups; Lift freezes a whole cone of divers in the air where your strikers can pick them off. Density when you are focused: 30% less damage, unstoppable, and landing on someone hurts them. Ground Zero is the payoff for any pull or slow: everything in 8 m is dragged to the center and detonated."
health = 350.0
shield = 200.0
movement = SubResource("Resource_abjh5")
hitbox = SubResource("Resource_8ce37")
primary = SubResource("Resource_d72a0")
secondary = SubResource("Resource_dbbn7")
ability_1 = SubResource("Resource_7jfij")
ability_2 = SubResource("Resource_n6lrl")
ultimate = SubResource("Resource_e0wos")
hero_script = ExtResource("10_b8eul")
visual = SubResource("Resource_v5680")
audio = SubResource("Resource_sn64h")
theme_color = Color(0.6, 0.42, 0.98, 1)
ai = SubResource("Resource_b8eul")
counters = Array[StringName]([&"harrier", &"sable", &"ricochet", &"wisp"])
countered_by = Array[StringName]([&"kiln", &"tallow", &"suture", &"cathedral"])
synergies = Array[StringName]([&"bombard", &"coil", &"ballast", &"vesper"])
unique_mechanic = "Lift: every enemy in a 35 degree cone within 12 m floats helplessly for 1.6 s. They can still aim, shoot and use abilities, but cannot move or jump. Unstoppable enemies are immune."
difficulty = 3
