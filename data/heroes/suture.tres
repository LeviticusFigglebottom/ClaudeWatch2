[resource]
script = ExtResource("16_spfx8")
id = &"suture"
display_name = "Suture"
codename = "The Medic"
role = 2
sort_order = 23
tagline = "Hold still. This part hurts."
lore = "Suture ran a rooftop clinic in the Nightmarket towers where the only anaesthetic was speed. Her stapler-gun closes a wound in one shot and her bandage shells were made for patching people who will not stop moving. She took the runner contract because the Charters pay in medical stock, and because somebody on every drop is going to need her."
playstyle = "Tether the bulwark and the striker who is taking the most fire, then every bandage you land on one of them heals both. Bandage Volley is your main heal: shoot it AT the ally, the shells burst on contact. Staple enemies to keep the pressure up, staple allies in a pinch. Adrenaline on your best duelist; Triage when the fight turns."
health = 225.0
movement = SubResource("Resource_84dr1")
hitbox = SubResource("Resource_l4mkd")
primary = SubResource("Resource_bearb")
secondary = SubResource("Resource_eemaw")
ability_1 = SubResource("Resource_y107q")
ability_2 = SubResource("Resource_34cpc")
ultimate = SubResource("Resource_dwbep")
hero_script = ExtResource("12_6ggd3")
visual = SubResource("Resource_rjd5m")
audio = SubResource("Resource_vv10s")
theme_color = Color(0.55, 0.92, 0.75, 1)
ai = SubResource("Resource_6ggd3")
counters = Array[StringName]([&"bramble", &"kiln", &"coil"])
countered_by = Array[StringName]([&"wisp", &"ballast", &"rook"])
synergies = Array[StringName]([&"ballast", &"cathedral", &"kiln"])
unique_mechanic = "Tether: links the two most recently tethered allies (or one ally and Suture) for 6 s. Every point of healing Suture puts into one end of the tether is copied to the other end."
difficulty = 2
