[resource]
script = ExtResource("16_g0efk")
id = &"coil"
display_name = "Coil"
codename = "The Welder"
sort_order = 13
tagline = "Stand together. Please."
lore = "Coil welded hull plate in the Nightmarket towers, the neon stacks where the Pearl River Charter grows upward because it cannot grow out. Her gauntlet is a plasma welder with the safety filed off; the Tesla nodes are the same cheap lamp-posts she used to fix. She took the Runner contract for the money and stayed because nobody else on a drop site knew how the grid worked."
playstyle = "Find the clump. Every shot on one target arcs to two more within 6 m, so aim at whoever is standing closest to the others. Drop a Tesla Node where the enemy has to pass and chain through it, pop Capacitor when the whole team turns on you and hand it back as a burst, and save Blackout for the moment the enemy commits to an ultimate."
health = 225.0
movement = SubResource("Resource_vsuen")
hitbox = SubResource("Resource_e4q8n")
primary = SubResource("Resource_x2xia")
secondary = SubResource("Resource_rnah3")
ability_1 = SubResource("Resource_ror12")
ability_2 = SubResource("Resource_vw8lq")
ultimate = SubResource("Resource_2qmbk")
hero_script = ExtResource("11_e4q8n")
visual = SubResource("Resource_4mts4")
audio = SubResource("Resource_5lfey")
theme_color = Color(0.62, 0.42, 1, 1)
ai = SubResource("Resource_vgda2")
counters = Array[StringName]([&"cathedral", &"cadence", &"suture"])
countered_by = Array[StringName]([&"cathedral", &"tallow", &"suture"])
synergies = Array[StringName]([&"rook", &"ballast", &"vesper"])
unique_mechanic = "Chain: lightning from the gauntlet jumps from the enemy you hit to up to two more enemies within 6 m (70% then 50% damage). Friendly Tesla Nodes act as relays the chain can pass through."
difficulty = 2
