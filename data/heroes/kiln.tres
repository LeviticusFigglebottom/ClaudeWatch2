[resource]
script = ExtResource("15_5qhd8")
id = &"kiln"
display_name = "Kiln"
codename = "Unit K-17"
role = 0
sort_order = 3
tagline = "Every fight is a foundry."
lore = "K-17 was a foundry golem in the Ruhr Charter's salvage smelters, poured to pull white-hot reactor plate out of the melt by hand. When the smelters shut down the crew could not bring themselves to scrap it, so they taught it to walk the drop sites instead. Kiln does not know it is not a person. Nobody on its team has ever wanted to correct it. It builds cover the way other people breathe: because there is heat inside and it has to go somewhere."
playstyle = "Trade damage to build Heat, then spend it on terrain: Slag Cast a wall you and your team can stand on, Vent an ally onto a ledge nobody expected them to reach. Fight close so the slugs and the Furnace Blast connect; the burn does the rest. Meltdown when you are surrounded: 300 overhealth, unstoppable, and everything near you burns."
health = 425.0
armor = 175.0
movement = SubResource("Resource_gtcx3")
hitbox = SubResource("Resource_fi1mm")
primary = SubResource("Resource_ilfo6")
secondary = SubResource("Resource_ryufy")
ability_1 = SubResource("Resource_h2mgc")
ability_2 = SubResource("Resource_swid1")
ultimate = SubResource("Resource_7hio5")
hero_script = ExtResource("10_171mk")
hero_resource_name = "Heat"
hero_resource_max = 100.0
hero_resource_regen = -4.0
visual = SubResource("Resource_xqppi")
audio = SubResource("Resource_171mk")
theme_color = Color(1, 0.5, 0.15, 1)
ai = SubResource("Resource_w1kpv")
counters = Array[StringName]([&"ballast", &"sable", &"bramble", &"tallow"])
countered_by = Array[StringName]([&"suture", &"vesper", &"bombard", &"harrier"])
synergies = Array[StringName]([&"harrier", &"vesper", &"cadence", &"cairn"])
unique_mechanic = "Heat: a 0-100 resource built by dealing (0.3/pt) and taking (0.15/pt) damage that decays 4/s. Vent costs 30 heat, Slag Cast costs 40. Meltdown refills it."
difficulty = 2
