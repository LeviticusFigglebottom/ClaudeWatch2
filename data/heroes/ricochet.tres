[resource]
script = ExtResource("14_3cq12")
id = &"ricochet"
display_name = "Ricochet"
codename = "The Trick Shot"
sort_order = 12
tagline = "The wall is on my side."
lore = "Ricochet learned angles in the pit-arenas under Aurelia Bazaar, where the crowd only paid for shots that came from somewhere impossible. The launcher was a prize; the discs he cuts himself from Ring alloy that never dulls. He does not aim at people. He aims at the world and lets it deliver."
playstyle = "Never shoot straight at anyone. Skip discs off floors, walls and ceilings so they arrive armed; fight in corridors and rooms where every surface is a friend. Bank Shot when you cannot find the angle, Skip to break contact and leave a trap, and Pinball inside a room to make the whole room lethal."
health = 225.0
movement = SubResource("Resource_dwege")
hitbox = SubResource("Resource_hc6vp")
primary = SubResource("Resource_mejkm")
secondary = SubResource("Resource_qwqdg")
ability_1 = SubResource("Resource_kc72j")
ability_2 = SubResource("Resource_cghjk")
ultimate = SubResource("Resource_6kg3n")
visual = SubResource("Resource_wegxb")
audio = SubResource("Resource_2qnwf")
theme_color = Color(0.95, 0.4, 0.75, 1)
ai = SubResource("Resource_nmod2")
counters = Array[StringName]([&"cathedral", &"kiln", &"cairn"])
countered_by = Array[StringName]([&"vesper", &"bombard", &"harrier"])
synergies = Array[StringName]([&"cairn", &"coil", &"rook"])
unique_mechanic = "Discs only damage after bouncing at least once: a fresh disc flies straight through enemies. Each bounce arms it harder, 45 -> 70 -> 95 damage, up to three bounces."
difficulty = 3
