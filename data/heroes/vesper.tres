[resource]
script = ExtResource("15_5otm2")
id = &"vesper"
display_name = "Vesper"
codename = "The Lamplighter"
sort_order = 10
tagline = "Light finds everyone."
lore = "Vesper ran salvage routes on the dark side of the Ring for eleven years, navigating by the glow of lantern buoys she planted herself. When the Charters started paying for Cores, she brought the lanterns down with her. Her rifle is a converted surveying laser; her calm is not an act."
playstyle = "Hold long sightlines, tag targets with the Lantern so your team can see them coming, and punish anyone who peeks. You are weakest up close: keep the zipline for escapes."
movement = SubResource("Resource_ej6ka")
hitbox = SubResource("Resource_yewef")
primary = SubResource("Resource_2b5yq")
secondary = SubResource("Resource_hqiqb")
ability_1 = SubResource("Resource_6nx3q")
ability_2 = SubResource("Resource_rpyg6")
ultimate = SubResource("Resource_iuwhh")
visual = SubResource("Resource_sn4dl")
audio = SubResource("Resource_32vv7")
theme_color = Color(0.98, 0.78, 0.35, 1)
ai = SubResource("Resource_7m3iy")
counters = Array[StringName]([&"sable", &"harrier", &"wisp"])
countered_by = Array[StringName]([&"cathedral", &"ballast", &"rook"])
synergies = Array[StringName]([&"bombard", &"coil", &"lumen"])
unique_mechanic = "Lantern: throws a lamp that REVEALS all enemies in a 12 m radius through walls for 6 s to your entire team."
difficulty = 2
